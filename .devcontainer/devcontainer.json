{
    "init": true,
    "name": "Chord",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "../desktop/scripts"
    },
    "remoteUser": "vscode",
    "capAdd": ["SYS_PTRACE"],
    "securityOpt": ["seccomp=unconfined"],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools",
                "TheQtCompany.qt-qml",
                "GitHub.vscode-github-actions"
            ],
            "settings": {
                "cmake.generator": "Ninja",
                "cmake.sourceDirectory": "${workspaceFolder}/desktop",
                "cmake.buildDirectory": "${workspaceFolder}/desktop/build",
                "cmake.configureSettings": {
                    "CMAKE_BUILD_TYPE": "Debug",
                    "CMAKE_EXPORT_COMPILE_COMMANDS": true,
                    "CMAKE_INSTALL_PREFIX": "${workspaceFolder}/desktop/build/install"
                }
            }
        }
    }
}
